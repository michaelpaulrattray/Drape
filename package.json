{
  "name": "drape",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:servers": "tsx scripts/dev-servers.mts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && esbuild scripts/predeploy-migrate.mts --platform=node --packages=external --bundle --format=esm --outfile=dist/predeploy.js",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "pnpm run --parallel \"/^check:/\"",
    "check:root": "tsc --noEmit",
    "check:dispositions": "tsx scripts/check-cleanup-dispositions.mts --strict",
    "preflight": "tsx scripts/preflight.mts",
    "check:casting-tests": "tsc -p tsconfig.casting-tests.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "architecture:generate": "tsx scripts/generate-architecture.mts",
    "architecture:check": "tsx scripts/check-architecture.mts",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "capability:generate": "tsx scripts/generate-capability-atlas.mts",
    "capability:check": "tsx scripts/generate-capability-atlas.mts --check",
    "machinist:bundle": "tsx scripts/bundle-report.mts",
    "machinist:bench": "tsx scripts/bench-commands.mts",
    "machinist:latency": "tsx scripts/drive-interaction-latency.mts",
    "janitor:knip": "knip --no-progress --reporter compact",
    "warden:semgrep": "semgrep scan --config p/nodejs --config p/expressjs --config p/typescript --config p/javascript --metrics=off --error"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@google/genai": "^1.39.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.22.2",
    "framer-motion": "^12.23.22",
    "google-auth-library": "^11.1.0",
    "jose": "6.2.12",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.24.4",
    "nanoid": "^5.1.16",
    "p-limit": "^7.3.2",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^2.15.2",
    "resend": "^6.28.1",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "stripe": "^20.3.0",
    "superjson": "^1.13.3",
    "tailwind-merge": "^3.7.0",
    "uuid": "^13.0.1",
    "wouter": "^3.3.5",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.4",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.1",
    "knip": "^6.36.0",
    "prettier": "^3.9.8",
    "puppeteer-core": "^25.11.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    },
    "overrides": {
      "tar": ">=7.5.18",
      "lodash": ">=4.17.23",
      "lodash-es": ">=4.17.23",
      "qs": ">=6.14.1",
      "mdast-util-to-hast": ">=13.2.1",
      "esbuild": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "core-js",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  }
}
