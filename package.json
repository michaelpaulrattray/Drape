{
  "name": "drape",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "dev:servers": "tsx scripts/dev-servers.mts",
    "build": "vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit && tsc -p tsconfig.casting-tests.json --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsx scripts/check-cleanup-dispositions.mts --strict",
    "check:casting-tests": "tsc -p tsconfig.casting-tests.json --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:push": "drizzle-kit generate && drizzle-kit migrate",
    "architecture:generate": "tsx scripts/generate-architecture.mts",
    "architecture:check": "tsx scripts/check-architecture.mts",
    "check:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "capability:generate": "tsx scripts/generate-capability-atlas.mts",
    "capability:check": "tsx scripts/generate-capability-atlas.mts --check"
  },
