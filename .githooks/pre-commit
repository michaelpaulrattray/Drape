#!/bin/sh
#
# TWO REPEATS THE RETRO FOUND, TURNED INTO A GATE (patrol #1, docs/RETRO_LOG.md
# R3 and R4; cards #102 and #103). Each arm refuses ONE shape of commit that
# has happened more than once with the rule already written down. A sentence
# did not hold; a sentence will not hold.
#
# ARM 1 — R3, the shared-tree cross-commit. A shift branch (`team/*`) belongs
#   in its own worktree by the standing orders: several sessions share the
#   MAIN working tree, and a commit made there on a shift branch has landed
#   another seat's work on it more than once. So: a commit in the main tree
#   while HEAD is a `team/*` branch is refused. Everything else — `main`,
#   `census/*`, detached HEAD, ANY branch inside a linked worktree — is
#   untouched, so the founder's interactive sessions never meet it.
#
# ARM 0 — R1, the generated map. If the atlas merge driver queued a
#   regeneration (a merge where both sides changed the generated map), it is
#   performed here on the merged tree and staged before anything else is
#   judged — see .githooks/atlas-regenerate and .githooks/merge-atlas. Without
#   a queued regeneration this arm does nothing at all.
#
# ARM 2 — R4, the control byte. A non-raw Python heredoc turns `\b` into a
#   BACKSPACE (0x08) inside the file it writes; the file looks fine and parses
#   wrong, and once (`.gitleaks.toml`) the consequence was a scanner that
#   loaded nothing and reported all green. So: a staged TEXT file holding a
#   byte in 0x00-0x08, 0x0B, 0x0C or 0x0E-0x1F (tab, LF and CR excluded) is
#   refused, naming the file, the byte and where. Files git itself treats as
#   binary (`-text` in .gitattributes, or its own heuristic) are skipped by
#   construction — git's `--numstat` prints `-` for those, and that is the
#   reading used here rather than a second list of extensions.
#
# ARM 3 — #501, the stale map. ARM 0 covers a MERGE that touched a generated
#   map on both sides; an ordinary commit editing a module moved the source
#   fingerprint and regenerated nothing, so five of the last sixty gate runs
#   died on `Architecture Atlas freshness` alone. So a commit staging a path
#   the maps are built from regenerates them and carries them — see
#   .githooks/atlas-stage. It runs LAST, so that a commit arms 1 or 2 are
#   going to refuse does not pay nine seconds before being told.
#
#   ⚠ ONE MERGE ROAD PAYS TWICE AND THAT IS STATED RATHER THAN HIDDEN
#   (review of PR #517, finding 2): atlas-regenerate clears the marker
#   BEFORE its `automatic` branch exits, so the AUTOMATIC merge resume
#   (`git commit --no-edit`) arrives here with no marker and ARM 3
#   regenerates a tree ARM 0 regenerated a moment ago — nine seconds,
#   byte-identical output, harmless. The CONFLICTED road keeps its marker
#   through to this hook and is the one the skip below covers. Left as is:
#   a second marker to make the automatic road skip would be state that
#   can go stale, to save nine seconds on the rarer of two roads.
#
#   ⚠ AND THE MAPS ARM 3 STAGES ARE NOT SEEN BY ARM 2's CONTROL-BYTE SCAN,
#   because ARM 3 runs after it. Deliberate — the ordering is what keeps a
#   refusal cheap — and near-zero risk, since the bytes are generator output
#   rather than anything a heredoc wrote. The MERGE road's maps ARE scanned:
#   ARM 0 stages them before ARM 2 runs. Said here rather than left as a
#   difference between the two roads that nobody wrote down.
#
# ⚠ ALL THREE ARMS ARE SKIPPED ON THE SAME THREE ROADS, AND ONLY ONE HAS A
# BACKSTOP (law-7 sweep of #606/#519, from PR #610's review). Measured on git
# 2.55, one scratch repository per road: `git revert`, `git cherry-pick` and a
# REPLAYED rebase commit do not run this hook at all. (`git commit --amend`
# does, so the amend road is not on this list.) That is not a property of ARM 3
# — it is a property of the HOOK, so every arm here is absent on those roads:
#
#   ARM 3, the stale map — BACKSTOPPED. `.githooks/pre-push` ARM 2 runs the
#     rite's own freshness checks before any branch push (#606, #519).
#   ARM 1, the shared-tree cross-commit (R3) — BACKSTOPPED since #611.
#     `.githooks/prepare-commit-msg` refuses a commit landing on a `team/*`
#     branch from the main tree on all three of these roads. It shares this
#     arm's condition and its refusal through `.githooks/shift-branch-guard`
#     rather than restating them, so the rule cannot become two rules. Read
#     that hook's header before changing either: it carries the measured table
#     of which hooks FIRE and which can REFUSE on which road — including why
#     `post-checkout`, which #611 itself recommended, cannot refuse anything,
#     and why the `reference-transaction` version that also worked was
#     discarded (seven invocations per commit, fourteen per checkout).
#   ARM 2, the control byte (R4) — NOT backstopped, and the exposure is small:
#     a replayed commit's bytes were scanned when it was first created. It bites
#     only on a cherry-pick of a commit made with --no-verify or authored
#     outside this repository.
#     ⚠ SINCE #611 THE ROAD TO BACKSTOPPING IT IS CHEAP AND OPEN, and that is
#     recorded rather than taken: `prepare-commit-msg` runs with the index
#     already staged, so this arm's `git diff --cached` scan would work there
#     unchanged. It was left because #611 scoped itself to ARM 1, because the
#     scan would then run twice on every ordinary commit, and because nothing
#     has measured the exposure as worth that. Filed on #611, not forgotten.
#
# THE ESCAPE IS FIXING THE COMMIT, NOT --no-verify. Driven by
# server/preCommitGate.test.ts against real temporary repositories.
#
# Installed by:  git config core.hooksPath .githooks

# ---------------------------------------------------------------- ARM 0 (R1)
# Read the marker BEFORE the hook clears it: when the merge path regenerates,
# ARM 3 below has nothing left to do and must not pay for it twice.
atlas_gitdir=$(git rev-parse --git-dir 2>/dev/null)
atlas_merge_regenerated=0
[ -n "$atlas_gitdir" ] && [ -f "$atlas_gitdir/DRAPE_ATLAS_REGENERATE" ] && atlas_merge_regenerated=1
"$(dirname "$0")/atlas-regenerate" || exit 1

# ---------------------------------------------------------------- ARM 1 (R3)
# The condition and the refusal are SOURCED, not written here: this arm has a
# second reader since #611 (.githooks/reference-transaction, the backstop for
# the three roads git skips this hook on), and a rule with two readers kept as
# two copies is working law 4's own shape. What stays here is the question
# THIS hook asks — what is HEAD — which is not the question that one asks.
. "$(dirname "$0")/shift-branch-guard"

branch=$(git symbolic-ref --short -q HEAD 2>/dev/null)
case "$branch" in
  team/*)
    if drape_in_main_working_tree; then
      drape_refuse_shift_branch "$branch" "This commit"
      exit 1
    fi
    ;;
esac

# ---------------------------------------------------------------- ARM 2 (R4)
# The scan needs grep's -P (Git for Windows and GNU grep have it; BSD grep
# does not). A guard whose dependency is missing REFUSES rather than allows
# (enforcement invariant 7) — otherwise a platform without -P would pass every
# byte silently and read as clean.
if ! printf 'a' | LC_ALL=C grep -q -P 'a' 2>/dev/null; then
  echo "" >&2
  echo "REFUSED — this grep has no -P, so the control-byte scan cannot run." >&2
  echo "Install GNU grep (or run the commit from Git Bash) rather than bypassing." >&2
  echo "" >&2
  exit 1
fi

# Staged paths that will exist after the commit (added, copied, modified,
# renamed) — a deletion has no blob to scan. One listing for the whole index:
# `-` in the first numstat column is git's own verdict that the blob is
# binary, honouring .gitattributes and its content heuristic alike.
# --no-renames keeps the path column a plain path (no `old => new`).
tab=$(printf '\t')
git diff --cached --numstat --no-renames --diff-filter=ACMR 2>/dev/null | while IFS="$tab" read -r added _deleted path; do
  [ -n "$path" ] || continue
  [ "$added" = "-" ] && continue
  hit=$(git show ":$path" 2>/dev/null | LC_ALL=C grep -a -o -b -m 1 -P '[\x00-\x08\x0B\x0C\x0E-\x1F]' 2>/dev/null | head -n 1)
  if [ -n "$hit" ]; then
    offset=${hit%%:*}
    byte=$(printf '%s' "${hit#*:}" | od -An -tx1 | tr -d ' \n')
    echo "" >&2
    echo "REFUSED — $path holds a control byte 0x$byte at offset $offset." >&2
    echo "" >&2
    echo "A file that looks fine and parses wrong: this is the shape a non-raw Python" >&2
    echo "heredoc leaves behind when it turns \\b into a backspace (0x08). Write the" >&2
    echo "file with a raw string (r'''...''') or chr(), or with a tool that does not" >&2
    echo "interpret escapes, then re-stage it." >&2
    echo "" >&2
    echo "(docs/RETRO_LOG.md R4 — bit two shifts, one of them while citing the" >&2
    echo "memory. Never --no-verify.)" >&2
    echo "" >&2
    exit 1
  fi
done || exit 1

# ---------------------------------------------------------------- ARM 3 (#501)
if [ "$atlas_merge_regenerated" = "0" ]; then
  "$(dirname "$0")/atlas-stage" || exit 1
fi

exit 0
