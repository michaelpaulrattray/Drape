#!/bin/sh
#
# TWO ARMS. ARM 1 — the rite is the only push path to production. ARM 2 — a
# BRANCH push carries a fresh map, which until now only `main` did.
#
# ─────────────────────────────────────────────────────────── ARM 1
#
# THE RITE IS THE ONLY PUSH PATH TO PRODUCTION, BY CONSTRUCTION.
#
# Ordered fable-982 after the SECOND hand-push in the program's record. The
# first (opus-630) produced a sentence in the rite's own header — "there is no
# such thing as a deploy too small for the ceremony" — and the second happened
# with that sentence already written. A sentence did not hold; a sentence will
# not hold. So the ceremony stops being a discipline and becomes a gate.
#
# `main` deploys production — since 2026-09-06 Railway builds from it directly
# (#508), and `local-migration`, which used to deploy beside it, is deleted. A
# push to `main` without the rite skips the freeze check, which is the reading
# that asks whether the founder has paid work in flight — the judgement that is
# exactly wrong when it is wrong. (A PR merge is the other road to `main` and
# carries the gate instead; this hook is about HAND pushes.)
#
# The marker is set by scripts/deploy-rite.mts on the git child it spawns, and
# by nothing else. It is deliberately not a file, a flag or a branch name: those
# can be produced by a shift that has decided its push is fine.
#
# THE ESCAPE IS ASKING, NOT --no-verify. If a push genuinely must bypass the
# rite, say so in the mailbox and get a word back. Bypassing a hook silently is
# the same act this hook exists to stop, one level down.
#
# Installed by:  git config core.hooksPath .githooks
# The rite refuses to run when that config is absent, so the guard cannot be
# quietly uninstalled by the next person who clones.

# ─────────────────────────────────────────────────────────── ARM 2
#
# A BRANCH PUSH GETS THE FRESHNESS BACKSTOP `main` ALREADY HAD (cards #606, #519).
#
# `.githooks/pre-commit` ARM 3 (#501) regenerates the generated maps on any
# commit that could move them, so a branch normally pushes the map of its own
# tree. **But git does not run `pre-commit` on every road to a commit.**
# Measured here on git 2.55.0.windows.3, one scratch repository per road:
#
#     road                  pre-commit  prepare-commit-msg  post-commit  post-rewrite
#     ordinary commit           yes           yes               yes           -
#     git revert --no-edit      NO            yes               yes           -
#     git cherry-pick           NO            yes               yes           -
#     git rebase (replay)       NO            yes               yes          yes
#     git commit --amend        yes           yes               yes          yes
#
# So three roads skip the regeneration, and every one of them is a road shifts
# now walk on purpose: **under deploy-on-merge (#508) every rollback proof is a
# revert.** #606 is that, caught on PR #605 — `git revert --no-edit` deleted a
# module and the commit carried the old map, the gate's Architecture Atlas
# freshness step went red at ~3½ minutes, and it cost a regenerate, a second
# commit and a second seven-minute gate. #519 is the rebase half: the merge
# driver leaves a PLACEHOLDER for `pre-commit` to replace, and on a replayed
# commit nothing replaces it.
#
# ⚠ WHY NOT REPAIR IT AT THE COMMIT, WHICH IS WHAT BOTH CARDS FIRST PROPOSED.
# `prepare-commit-msg` fires on all three roads, so it looks like the answer.
# Driven instead of assumed: a `prepare-commit-msg` that writes and `git add`s a
# file lands it in a cherry-pick and in a rebase — **and NOT in a revert**,
# where the hook fires twice and the staged file is dropped. A repair that works
# on two of the three roads and silently fails on the third — the common one —
# is worse than no repair, because it reads as coverage. `post-commit` cannot
# refuse (its exit code is ignored) and cannot amend safely mid-sequencer.
#
# So this is a GATE rather than a repair, and it is the same reading the rite
# already performs before it pushes `main` — `merge-atlas`'s own stated limit
# ends *"the rite's freshness check is the backstop either way"*, which was true
# of `main` and false of every branch, because a branch push never meets the
# rite. This closes that asymmetry with the rite's own two commands.
#
# ⚠ IT REFUSES ONLY WHEN ITS VERDICT IS TRUSTWORTHY. Both checks read the bytes
# ON DISK, not the committed tree. With uncommitted work in a path the
# generators read, "stale" may be true of the working tree and false of the
# commit being pushed — so in that state it WARNS and lets the push through,
# rather than blocking a legitimate push on a question it cannot answer. The
# population is `.githooks/atlas-paths`, shared with the commit hook so the two
# cannot drift about which files matter.
#
# `drape.atlasCheck` overrides the check command; its only intended use is the
# guard's own test, which drives real temporary repositories with no generator.
# Driven by `server/atlasPushGate.test.ts`, against real repositories and a real
# `git push` to a real bare remote.

atlas_push_gate() {
  # The rite runs these two itself before it pushes main — do not pay twice.
  [ -n "$DRAPE_DEPLOY_RITE" ] && return 0

  hooks_dir=$(dirname "$0")
  . "$hooks_dir/atlas-paths" || {
    echo "REFUSED — cannot read .githooks/atlas-paths, so map freshness cannot be judged." >&2
    return 1
  }

  check=$(git config drape.atlasCheck 2>/dev/null)
  [ -n "$check" ] || check="pnpm architecture:check && pnpm capability:check"

  # stdin is git's ref list and the loop below is still reading it — a check
  # command that consumed it would silently eat refs.
  out=$(sh -c "$check" </dev/null 2>&1)
  status=$?
  [ "$status" -eq 0 ] && return 0

  # Stale — but is the staleness the COMMIT's, or uncommitted work on disk?
  dirty=$( { git diff --name-only 2>/dev/null; git ls-files --others --exclude-standard 2>/dev/null; } \
    | grep -E "$WARN_MATCHES" | sort -u)
  if [ -n "$dirty" ]; then
    echo "" >&2
    echo "atlas: ⚠ the generated maps read STALE, but these sources are uncommitted:" >&2
    echo "" >&2
    printf '  %s\n' $dirty >&2
    echo "" >&2
    echo "Both checks read the bytes on disk, so this may be true of your working tree" >&2
    echo "and false of the commits being pushed. The push is allowed — but if the gate" >&2
    echo "reddens on Architecture Atlas freshness, this is why." >&2
    echo "" >&2
    return 0
  fi

  echo "" >&2
  echo "REFUSED — the working tree is clean and the generated maps are STALE, so these" >&2
  echo "commits carry a map that does not describe them." >&2
  echo "" >&2
  printf '%s\n' "$out" | tail -n 5 >&2
  echo "" >&2
  echo "  pnpm architecture:generate && pnpm capability:generate" >&2
  echo "" >&2
  echo "then review the diff and commit it. git does not run pre-commit on a revert," >&2
  echo "a cherry-pick or a replayed rebase commit, so the map was never rebuilt for" >&2
  echo "this one. (cards #606, #519 — never --no-verify.)" >&2
  echo "" >&2
  return 1
}

protected_ref() {
  case "$1" in
    refs/heads/main) return 0 ;;
    *) return 1 ;;
  esac
}

deleting_ref() {
  # git sends the all-zero sha as the local side of a branch DELETION; there is
  # no tree to judge, so the freshness arm must not fire on one.
  case "$1" in
    *[!0]*) return 1 ;;
    "") return 1 ;;
    *) return 0 ;;
  esac
}

atlas_checked=0

while read -r _local_ref local_sha remote_ref _remote_sha; do
  if protected_ref "$remote_ref"; then
    if [ -z "$DRAPE_DEPLOY_RITE" ]; then
      echo "" >&2
      echo "REFUSED — $remote_ref deploys production, and this push did not come from the rite." >&2
      echo "" >&2
      echo "  npx tsx scripts/deploy-rite.mts        (freeze check, push, watch, health)" >&2
      echo "  npx tsx scripts/deploy-rite.mts --dry  (every reading, no push)" >&2
      echo "" >&2
      echo "The freeze check is the reason: it reads whether the founder has paid work" >&2
      echo "in flight. A push that skips it is a judgement, and the judgement is the" >&2
      echo "part that is wrong when it is wrong." >&2
      echo "" >&2
      echo "If this push must genuinely bypass the rite, ASK in the mailbox and get a" >&2
      echo "word back. Never --no-verify." >&2
      echo "" >&2
      exit 1
    fi
  fi

  # Once per push, whatever the ref count: the checks read one working tree.
  if [ "$atlas_checked" = "0" ] && ! deleting_ref "$local_sha"; then
    atlas_checked=1
    atlas_push_gate || exit 1
  fi
done

exit 0
